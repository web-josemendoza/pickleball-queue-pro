{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('players').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === 'player') || root.child('players').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "queue": {
      ".read": true,
      ".write": "auth != null && root.child('players').child(auth.uid).child('role').val() === 'admin'",
      "$playerId": {
        ".write": "auth != null && (auth.uid === $playerId || root.child('players').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "tournament": {
      ".read": true,
      "current": {
        ".write": "auth != null && ((data.exists() && newData.exists()) || root.child('players').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$tokenId": {
          ".validate": "newData.hasChildren(['token', 'createdAt']) && newData.child('token').isString() && newData.child('token').val().length < 4096"
        }
      }
    },

    "openPlay": {
      ".read": true,
      ".write": "auth != null && root.child('players').child(auth.uid).child('role').val() === 'admin'",

      "game": {
        ".write": "auth != null && (newData.exists() || root.child('players').child(auth.uid).child('role').val() === 'admin')"
      }
    }
  }
}
